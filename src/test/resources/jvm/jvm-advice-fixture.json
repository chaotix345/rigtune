    {"id": "jvm-zgc-small-pc", "when": {"flags": ["jvm-gc-zgc"], "ramMbAtMost": 8192, "heapMbAtLeast": 4096}, "kind": "info", "impact": "low", "title": "ZGC keeps the whole heap in memory", "text": "fixture"},
