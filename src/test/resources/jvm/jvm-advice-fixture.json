    {"id": "jvm-stop-the-world-gc", "when": {"anyOf": [{"flags": ["jvm-gc-parallel", "jvm-gc-typed"]}, {"flags": ["jvm-gc-serial", "jvm-gc-typed"]}]}, "kind": "warning", "impact": "medium", "title": "A collector for work where long pauses are acceptable", "text": "fixture"},
